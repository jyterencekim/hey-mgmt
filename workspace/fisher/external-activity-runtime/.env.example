# ─────────────────────────────────────────────────────────────────────────────
# Fisher External Activity Runtime Credentials
# Copy this file to `workspace/fisher/external-activity-runtime/.env`
# (or put these variables in the repository root `.env`).
# Both `./hey` and the Fisher daemon load both `.env` files automatically.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Slack Collector & Socket Mode Bot
# Required scopes: channels:history, channels:read, groups:history, groups:read,
# im:history, im:read, im:write, chat:write, reactions:write, users:read
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_APP_TOKEN=xapp-replace-me
SLACK_WORKSPACE_URL=https://your-workspace.slack.com

# 2. Notion Meeting Ingestion (`./hey meeting import-notion`)
# Create an Internal Integration at https://www.notion.so/profile/integrations
# and share your Notion meeting database with the integration.
NOTION_TOKEN=ntn_replace_me

# 3. Gmail + Google Docs Meeting Ingestion (`./hey meeting import-gmail`)
# OAuth2 credentials with gmail.readonly + documents.readonly scopes
GMAIL_CLIENT_ID=replace-me.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=replace-me
GMAIL_REFRESH_TOKEN=replace-me
GMAIL_USER=me

# 4. Google Drive Activity Collector (`./hey activity poll --source drive`)
# Supports GOOGLE_SERVICE_ACCOUNT_JSON_PATH, GOOGLE_SERVICE_ACCOUNT_JSON,
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64, or GOOGLE_SERVICE_ACCOUNT_EMAIL + GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/path/to/service-account.json
GOOGLE_IMPERSONATED_USER=alice@example.com

# 5. Atlassian Confluence Collector (`./hey activity poll --source confluence`)
ATLASSIAN_EMAIL=alice@example.com
ATLASSIAN_API_TOKEN=replace-me
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net

# 6. GitHub Collector (`./hey activity poll --source github`)
# Optional if `gh auth login` is already authenticated on the machine
GITHUB_TOKEN=ghp_replace_me

# 7. Optional: OpenRouter / LLM Distillation
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openai/gpt-5.4-mini
