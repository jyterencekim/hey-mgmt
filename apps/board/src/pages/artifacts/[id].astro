---
import Layout from "@/layouts/main.astro"
import MarkdownBody from "@/components/MarkdownBody.astro"
import { loadAll, readArtifactMarkdown } from "@/lib/manifest"
import { toArtifactHref, toVsCodeHref } from "@/lib/repo"
import { buildDocsTree, childPages, docLocation, parentPages } from "@/lib/docs-tree"
import type { ManifestEntry } from "@/lib/types"

export async function getStaticPaths() {
  return loadAll()
    .filter((artifact) => artifact.type !== "task")
    .map((artifact) => ({
      params: { id: artifact.id },
      props: { artifact },
    }))
}

interface Props {
  artifact: ManifestEntry
}

const { artifact } = Astro.props
const markdown = readArtifactMarkdown(artifact.path)
const body = markdown.body.trim()

// Where the page sits in the Docs tree, plus explicit parent/child edges.
const entries = loadAll()
const treePath = docLocation(buildDocsTree(entries), artifact.id)
const parents = parentPages(artifact, entries)
const children = childPages(artifact.id, entries)

const fieldRows = [
  ["ID", artifact.id],
  ["Type", artifact.type],
  ["Status", artifact.status],
  ["Owner", artifact.owner],
  ["Area", artifact.area],
  ["Created", artifact.created_at],
  ["Updated", artifact.updated_at],
  ["Path", artifact.path],
]

function display(value: string | null): string {
  return value && value.length > 0 ? value : "—"
}
---

<Layout title={artifact.title}>
  <div class="mb-4">
    <a
      href="/"
      data-back-link
      class="text-sm text-muted-foreground hover:text-muted-foreground"
      >← Back</a
    >
  </div>
  <script is:inline>
    // Prefer a real "back" so returning to the referring view (e.g. the Goals
    // timeline/table) is preserved. Fall back to the href on direct entry.
    ;(function () {
      var link = document.querySelector("[data-back-link]")
      if (!link) return
      link.addEventListener("click", function (e) {
        var ref = document.referrer
        if (
          window.history.length > 1 &&
          ref &&
          new URL(ref).origin === window.location.origin
        ) {
          e.preventDefault()
          window.history.back()
        }
      })
    })()
  </script>

  <header class="mb-6">
    <div class="mb-3 flex flex-wrap items-center gap-2">
      <span
        class="rounded bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground"
      >
        {artifact.type}
      </span>
      {
        artifact.status && (
          <span class="rounded bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
            {artifact.status}
          </span>
        )
      }
      <a
        href={toVsCodeHref(artifact.path)}
        class="rounded bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground hover:bg-muted"
        title={markdown.absolutePath}
      >
        VS Code
      </a>
    </div>
    {
      treePath.length > 0 && (
        <nav aria-label="Breadcrumb" class="mb-2 flex flex-wrap items-center gap-1 text-xs text-muted-foreground">
          <a href="/docs/" class="hover:text-foreground">Docs</a>
          {treePath.map((f) => (
            <>
              <span>/</span>
              <a href={`/docs/?folder=${encodeURIComponent(f.key)}`} class="hover:text-foreground">
                {f.label}
              </a>
            </>
          ))}
        </nav>
      )
    }
    <h1 class="max-w-4xl text-2xl leading-tight font-semibold text-foreground">
      {artifact.title}
    </h1>
    <p class="mt-2 font-mono text-xs text-muted-foreground">{artifact.id}</p>
  </header>

  {
    parents.length > 0 && (
      <p class="-mt-3 mb-6 text-sm text-muted-foreground">
        Parent:{" "}
        {parents.map((p, i) => (
          <>
            {i > 0 && ", "}
            <a href={toArtifactHref(p.id)} class="font-medium text-foreground hover:underline">
              {p.title}
            </a>
          </>
        ))}
      </p>
    )
  }

  {
    children.length > 0 && (
      <section class="mb-8">
        <h2 class="mb-3 text-sm font-medium tracking-wide text-muted-foreground uppercase">
          Child pages <span class="font-mono normal-case">{children.length}</span>
        </h2>
        <ul class="divide-y divide-border rounded-lg border border-border bg-card">
          {children.map((c) => (
            <li>
              <a
                href={toArtifactHref(c.id)}
                class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-2.5 transition-colors hover:bg-muted"
              >
                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-muted-foreground uppercase">
                  {c.type}
                </span>
                <span class="min-w-[14rem] flex-1 text-sm leading-snug font-medium break-words text-foreground">{c.title}</span>
                {c.owner && <span class="text-xs text-muted-foreground">{c.owner}</span>}
                {c.status && <span class="text-xs text-muted-foreground">{c.status}</span>}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mb-8">
    <h2
      class="mb-3 text-sm font-medium tracking-wide text-muted-foreground uppercase"
    >
      Frontmatter
    </h2>
    <div class="overflow-x-auto rounded-lg border border-border bg-card">
      <table class="w-full text-sm">
        <tbody>
          {
            fieldRows.map(([label, value]) => (
              <tr class="border-b border-border last:border-b-0">
                <th class="w-36 px-4 py-2 text-left font-medium text-muted-foreground">
                  {label}
                </th>
                <td class="px-4 py-2 text-foreground">{display(value)}</td>
              </tr>
            ))
          }
          <tr class="border-b border-border">
            <th class="w-36 px-4 py-2 text-left font-medium text-muted-foreground">
              Tags
            </th>
            <td class="px-4 py-2 text-foreground">
              {artifact.tags.length > 0 ? artifact.tags.join(", ") : "—"}
            </td>
          </tr>
          <tr class="border-b border-border">
            <th
              class="w-36 px-4 py-2 text-left align-top font-medium text-muted-foreground"
            >
              Relations
            </th>
            <td class="px-4 py-2 text-foreground">
              {
                artifact.relations_out.length === 0 ? (
                  "—"
                ) : (
                  <ul class="space-y-1">
                    {artifact.relations_out.map((relation) => (
                      <li>
                        <span class="text-muted-foreground">{relation.type}</span>
                        <span class="px-1 text-muted-foreground/60">→</span>
                        <a
                          href={toArtifactHref(relation.target)}
                          class="font-mono text-xs font-medium hover:underline"
                        >
                          {relation.target}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </td>
          </tr>
          <tr>
            <th
              class="w-36 px-4 py-2 text-left align-top font-medium text-muted-foreground"
            >
              Sources
            </th>
            <td class="px-4 py-2 text-foreground">
              {
                artifact.sources.length === 0 ? (
                  "—"
                ) : (
                  <ul class="space-y-1">
                    {artifact.sources.map((source) => (
                      <li>
                        {source.url ? (
                          <a
                            href={source.url}
                            class="font-medium hover:underline"
                          >
                            {source.title ?? source.url}
                          </a>
                        ) : (
                          <span>
                            {source.title ??
                              source.ref ??
                              source.kind ??
                              "source"}
                          </span>
                        )}
                      </li>
                    ))}
                  </ul>
                )
              }
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section>
    <h2
      class="mb-3 text-sm font-medium tracking-wide text-muted-foreground uppercase"
    >
      Body
    </h2>
    <MarkdownBody body={body} scope="artifact" />
  </section>
</Layout>
