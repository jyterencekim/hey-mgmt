---
interface Props {
  href: string
  titlePath: string
  label: string
  variant?: "chip" | "icon"
}

const { href, titlePath, label, variant = "icon" } = Astro.props

const baseClasses =
  "inline-flex items-center justify-center rounded text-muted-foreground hover:bg-muted hover:text-foreground transition-colors"
const sizeClasses =
  variant === "chip"
    ? "h-7 w-7 bg-muted hover:bg-muted text-muted-foreground"
    : "h-6 w-6"
---

<a
  href={href}
  class={`${baseClasses} ${sizeClasses}`}
  aria-label={`Open ${label} in VS Code`}
  title={titlePath}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    width="14"
    height="14"
    aria-hidden="true"
  >
    <path d="M9.5 2.5v3h3"></path>
    <path d="M12.5 5.5L9.5 2.5H4a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1h7.5a1 1 0 0 0 1-1V5.5z"
    ></path>
    <path d="M6 11l-1.5-1.5L6 8"></path>
    <path d="M9.5 8L11 9.5 9.5 11"></path>
  </svg>
</a>
