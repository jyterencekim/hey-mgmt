---
import type { DocFolder } from "@/lib/docs-tree"

interface Props {
  folder: DocFolder
  depth: number
}

const { folder, depth } = Astro.props
const pad = `padding-left: ${0.5 + depth * 0.75}rem`
---

{
  folder.children.length === 0 ? (
    <a
      href={`/docs/?folder=${encodeURIComponent(folder.key)}`}
      data-tree-link={folder.key}
      class="doc-tree-link flex items-center gap-1.5 rounded py-1 pr-2 text-[13px] text-sidebar-foreground/80 hover:bg-muted"
      style={pad}
    >
      <span class="w-3 shrink-0" />
      <span class="flex-1 truncate">{folder.label}</span>
      <span class="font-mono text-[10px] text-muted-foreground">{folder.total}</span>
    </a>
  ) : (
    <details data-tree-node={folder.key}>
      <summary
        class="flex cursor-pointer list-none items-center gap-1.5 rounded py-1 pr-2 text-[13px] hover:bg-muted [&::-webkit-details-marker]:hidden"
        style={pad}
      >
        <svg
          width="10"
          height="10"
          viewBox="0 0 10 10"
          class="tree-chev w-3 shrink-0 text-muted-foreground transition-transform"
          aria-hidden="true"
        >
          <path d="M3 1.5 6.5 5 3 8.5" fill="none" stroke="currentColor" stroke-width="1.3" />
        </svg>
        <a
          href={`/docs/?folder=${encodeURIComponent(folder.key)}`}
          data-tree-link={folder.key}
          class={`doc-tree-link flex-1 truncate ${depth === 0 ? "font-medium text-foreground" : "text-sidebar-foreground/80"}`}
        >
          {folder.label}
        </a>
        <span class="font-mono text-[10px] text-muted-foreground">{folder.total}</span>
      </summary>
      {folder.children.map((child) => (
        <Astro.self folder={child} depth={depth + 1} />
      ))}
    </details>
  )
}

<style>
  /* Only the folder's own chevron turns; nested ones follow their own state. */
  details[open] > summary > .tree-chev {
    transform: rotate(90deg);
  }
</style>
