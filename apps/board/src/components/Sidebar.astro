---
import { getCurrentMember, listCoreTeam, loadInboxFor } from "@/lib/workspace"
import ThemeToggle from "@/components/islands/ThemeToggle"

const member = getCurrentMember()
const members = listCoreTeam(member)
const openInboxCount = loadInboxFor(member).filter(
  (i) => i.status === "open"
).length

const links = [
  { href: "/pulse/", label: "Pulse", icon: "pulse" as const },
  {
    href: "/inbox/",
    label: "Inbox",
    icon: "inbox" as const,
    count: openInboxCount,
  },
  { href: `/me/${member}/`, label: "My tasks", icon: "target" as const },
  { href: "/tasks/", label: "Team tasks", icon: "team" as const },
  { href: "/goals/", label: "Goals", icon: "goal" as const },
  { href: "/roadmap/", label: "Roadmap", icon: "roadmap" as const },
  { href: "/weekly/", label: "Weekly", icon: "weekly" as const },
  { href: "/iterations/", label: "Iterations", icon: "iter" as const },
  { href: "/docs/", label: "Docs", icon: "doc" as const },
  { href: "/graph/", label: "Graph", icon: "grid" as const },
]

const current = Astro.url.pathname

function isActive(href: string): boolean {
  if (href === "/") return current === "/"
  return current === href || current.startsWith(href)
}
---

<aside
  class="flex h-screen flex-col gap-1 overflow-y-auto border-r border-border bg-sidebar px-2 py-2 text-sidebar-foreground"
>
  <!-- workspace pill + theme toggle -->
  <div class="flex items-center justify-between px-2 py-1">
    <a href="/" class="flex items-center gap-2 rounded px-1 py-0.5 hover:bg-sidebar-accent">
      <span class="inline-flex h-5 w-5 items-center justify-center rounded bg-foreground text-[11px] font-bold text-background">H</span>
      <span class="text-sm font-medium">hey-mgmt</span>
    </a>
    <ThemeToggle client:load />
  </div>

  <!-- search trigger (visible affordance for Cmd+K) -->
  <button
    type="button"
    aria-label="Search (⌘K)"
    title="Search (⌘K)"
    onclick="window.dispatchEvent(new CustomEvent('hey:open-search'))"
    class="mt-1 flex items-center gap-2 rounded border border-border bg-background/40 px-2 py-1.5 text-sm text-muted-foreground transition-colors hover:bg-sidebar-accent hover:text-foreground"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="m21 21-4.35-4.35" />
    </svg>
    <span class="flex-1 text-left">Search</span>
    <kbd class="rounded border border-border bg-muted px-1.5 py-0.5 font-mono text-[10px] text-muted-foreground">⌘K</kbd>
  </button>

  <!-- main nav -->
  <nav class="mt-2 flex flex-col gap-px">
    {
      links.map((link) => (
        <a
          href={link.href}
          class={`group flex items-center gap-2 rounded px-2 py-1 text-sm transition-colors ${
            isActive(link.href)
              ? "bg-sidebar-accent text-sidebar-accent-foreground"
              : "text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground"
          }`}
        >
          <span
            class={`flex h-4 w-4 items-center justify-center ${isActive(link.href) ? "text-sidebar-foreground" : "text-sidebar-foreground/60 group-hover:text-sidebar-foreground"}`}
          >
            {link.icon === "pulse" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
              </svg>
            )}
            {link.icon === "inbox" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-6l-2 3h-4l-2-3H2" />
                <path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
              </svg>
            )}
            {link.icon === "target" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            )}
            {link.icon === "team" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
                <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                <circle cx="9" cy="7" r="4" />
              </svg>
            )}
            {link.icon === "goal" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z" />
                <line x1="4" y1="22" x2="4" y2="15" />
              </svg>
            )}
            {link.icon === "roadmap" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="3" y1="6" x2="14" y2="6" />
                <line x1="7" y1="12" x2="20" y2="12" />
                <line x1="5" y1="18" x2="16" y2="18" />
              </svg>
            )}
            {link.icon === "weekly" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="17" rx="2" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="8" y1="2" x2="8" y2="6" />
                <line x1="16" y1="2" x2="16" y2="6" />
              </svg>
            )}
            {link.icon === "iter" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 12a9 9 0 1 1-3-6.7" />
                <path d="M21 3v6h-6" />
              </svg>
            )}
            {link.icon === "doc" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
              </svg>
            )}
            {link.icon === "grid" && (
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
              </svg>
            )}
          </span>
          <span class="flex-1 truncate">{link.label}</span>
          {link.count != null && link.count > 0 && (
            <span class="text-xs text-sidebar-foreground/60">{link.count}</span>
          )}
        </a>
      ))
    }
  </nav>

  <!-- team -->
  <div class="mt-3">
    <div class="px-2 py-1 text-[10px] font-semibold uppercase tracking-wider text-sidebar-foreground/50">
      Team
    </div>
    <div class="flex flex-col gap-px">
      {
        members.map((m) => (
          <a
            href={`/me/${m}/`}
            class={`flex items-center gap-2 rounded px-2 py-1 text-sm transition-colors ${
              m === member && isActive(`/me/${m}/`)
                ? "bg-sidebar-accent text-sidebar-accent-foreground"
                : "text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground"
            }`}
          >
            <span class="flex h-4 w-4 items-center justify-center rounded bg-emerald-600 text-[9px] font-bold text-white">
              {m.charAt(0).toUpperCase()}
            </span>
            <span class="truncate">{m}</span>
            {m === member && (
              <span class="ml-auto text-[10px] text-sidebar-foreground/40">you</span>
            )}
          </a>
        ))
      }
    </div>
  </div>

  <!-- settings (bottom) -->
  <div class="mt-auto pt-2">
    <a
      href="/settings/"
      class={`group flex items-center gap-2 rounded px-2 py-1 text-sm transition-colors ${
        isActive("/settings/")
          ? "bg-sidebar-accent text-sidebar-accent-foreground"
          : "text-sidebar-foreground/80 hover:bg-sidebar-accent/60 hover:text-sidebar-foreground"
      }`}
    >
      <span class={`flex h-4 w-4 items-center justify-center ${isActive("/settings/") ? "text-sidebar-foreground" : "text-sidebar-foreground/60 group-hover:text-sidebar-foreground"}`}>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
        </svg>
      </span>
      <span>Settings</span>
    </a>
  </div>
</aside>
