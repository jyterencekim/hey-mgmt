---
interface Props {
  manifestPath: string
}

const { manifestPath } = Astro.props
---

<section
  class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center text-center"
>
  <p class="mb-2 text-xs font-medium tracking-wide text-muted-foreground uppercase">
    Index Missing
  </p>
  <h1 class="mb-3 text-2xl font-semibold text-foreground">
    Build the board index
  </h1>
  <p class="mb-5 text-sm leading-6 text-muted-foreground">
    The board reads the derived manifest before rendering tasks and initiatives.
  </p>
  <div class="flex flex-col gap-2 text-left sm:flex-row">
    <code
      class="rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground"
      >./hey index build</code
    >
    <code
      class="rounded-md border border-border bg-card px-3 py-2 text-sm text-foreground"
      >pnpm run dev:fresh</code
    >
  </div>
  <p class="mt-4 text-xs break-all text-muted-foreground">{manifestPath}</p>
</section>
