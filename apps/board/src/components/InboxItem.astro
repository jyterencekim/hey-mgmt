---
import type { InboxItem } from "@/lib/types"
import { formatDisplayDate } from "@/lib/date-format"

interface Props {
  item: InboxItem
}

const { item } = Astro.props

const statusClasses: Record<string, string> = {
  open: "border-l-4 border-sky-400 bg-card",
  read: "border-l-4 border-border bg-background",
  discarded: "border-l-4 border-border bg-background opacity-60",
}

const classes =
  statusClasses[item.status] ?? "border-l-4 border-border bg-card"

const excerpt = item.body
  ? item.body.length > 200
    ? item.body.slice(0, 200) + "…"
    : item.body
  : ""

const from = item.metadata?.x_from as string | undefined
const date = item.captured_at ? formatDisplayDate(item.captured_at) : ""
const detailHref = `/inbox/${item.workspace}/${item.id}/`
---

<div class={`rounded-r-lg p-4 ${classes}`}>
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
        <a
          href={detailHref}
          class="font-medium text-foreground hover:underline">{item.title}</a
        >
        <a
          href={item.vscodeHref}
          class="text-xs font-medium text-muted-foreground hover:text-foreground"
          aria-label={`Open ${item.title} in VS Code`}
          title={item.path}
        >
          VS Code
        </a>
      </div>
      <div class="mt-0.5 flex gap-3 text-xs text-muted-foreground">
        {from && <span>from {from}</span>}
        {date && <span>{date}</span>}
        <span class="capitalize">{item.status}</span>
      </div>
      {excerpt && <p class="mt-2 text-sm text-muted-foreground">{excerpt}</p>}
    </div>
    <div class="flex shrink-0 flex-col gap-1">
      <slot />
    </div>
  </div>
</div>
