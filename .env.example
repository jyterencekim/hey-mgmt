# Member configuration — run /setup or set manually
# Must match a name in content/vocab/members.yml
MEMBER=alice

# Response language (ko, en, ja, etc.)
LANGUAGE=ko

# Interaction tone preference: concise | balanced | coaching
# If unset, falls back to interaction_preference in content/vocab/members.yml,
# then interaction_preference_default (balanced). See playbook_interaction-tone.
# HEY_TONE=balanced

# Optional: custom path for team memory repo (default: ~/team-memory)
# MEMORY_REPO=~/team-memory

# Optional: Hermes Agent runtime integration
# HEY_HERMES_MODE=shadow
# HEY_HERMES_BASE_URL=http://127.0.0.1:8642
# HEY_HERMES_API_KEY=change-me
# HEY_HERMES_MODEL=hermes
# HEY_HERMES_SESSIONS_URL=
