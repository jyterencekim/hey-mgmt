# ─────────────────────────────────────────────────────────────────────────────
# 1. Core Member & CLI Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Active human member identity (must match a key in content/vocab/members.yml)
MEMBER=alice

# Primary language for ceremonies and skills (en | ko)
LANGUAGE=en

# Tone for CLI / agent output (concise | balanced | detailed)
HEY_TONE=concise

# Optional: Claude Code local memory path for Knowledge Graph build
# MEMORY_REPO=/Users/yourname/.claude/projects/.../memory

# Optional: Remote Hermes daemon SSH settings
# HEY_HERMES_SSH_TARGET=ubuntu@your-fisher-host
# HEY_HERMES_REMOTE_REPO=/home/ubuntu/hey-mgmt

# ─────────────────────────────────────────────────────────────────────────────
# 2. External Activity & Meeting Ingestion Credentials (Optional)
#    Note: ./hey loads both this root .env and
#    workspace/fisher/external-activity-runtime/.env automatically.
#    You can place credentials in either file.
# ─────────────────────────────────────────────────────────────────────────────

# --- Slack (used by `./hey activity poll --source slack` & Fisher bot) ---
# Create a Slack App with scopes: channels:history, channels:read, groups:history,
# groups:read, im:history, im:read, im:write, chat:write, users:read
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_APP_TOKEN=xapp-your-socket-mode-app-token
# SLACK_WORKSPACE_URL=https://your-workspace.slack.com

# --- Notion (used by `./hey meeting import-notion`) ---
# Create an Internal Integration at https://www.notion.so/profile/integrations
# and share your Meeting Notes database/pages with that integration.
# Put the Database ID in content/policies/meeting-ingestion.yml (notion.known_databases).
# NOTION_TOKEN=ntn_your_notion_integration_token

# --- Gmail + Google Docs (used by `./hey meeting import-gmail`) ---
# OAuth2 client with https://www.googleapis.com/auth/gmail.readonly and
# https://www.googleapis.com/auth/documents.readonly scopes.
# GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=your-client-secret
# GMAIL_REFRESH_TOKEN=your-refresh-token
# GMAIL_USER=me

# --- Google Drive Collector (used by `./hey activity poll --source drive`) ---
# Provide a Google Cloud Service Account with Drive API enabled (pick ONE method):
# Method A: Path to service-account JSON key file
# GOOGLE_SERVICE_ACCOUNT_JSON_PATH=/absolute/path/to/service-account.json
# Method B: Inline JSON or Base64-encoded JSON
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Ii...
# Optional: Domain-wide delegation impersonated user email
# GOOGLE_IMPERSONATED_USER=alice@example.com

# --- Atlassian Confluence (used by `./hey activity poll --source confluence`) ---
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# ATLASSIAN_EMAIL=alice@example.com
# ATLASSIAN_API_TOKEN=your-atlassian-api-token
# ATLASSIAN_BASE_URL=https://your-domain.atlassian.net

# --- GitHub (used by `./hey activity poll --source github`) ---
# If omitted, the collector automatically falls back to `gh auth status` CLI session.
# GITHUB_TOKEN=ghp_your_github_personal_access_token
